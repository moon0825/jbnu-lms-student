{
  "name": "jbnu-lms-mcp",
  "version": "0.1.0",
  "description": "전북대학교 LMS(JBNU LXP, Moodle/Coursemos) 학생용 읽기 전용 MCP 서버 (Windows 로컬 STDIO)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jbnu-lms-mcp": "dist/cli.js"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "login": "tsx src/cli.ts login",
    "status": "tsx src/cli.ts status",
    "logout": "tsx src/cli.ts logout",
    "doctor": "tsx src/cli.ts doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "luxon": "^3.7.2",
    "playwright-core": "^1.62.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
